# ---- Required (the ONLY things configured here; everything else is set from the bot's admin panel) ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
# API_ID / API_HASH optional (Autoposter Range + preview image; get them at https://my.telegram.org). BASE_URL = your public https URL, no trailing slash
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BASE_URL=https://your-app-name.koyeb.app

# ---- Permanent links (Cloudflare Worker, see cloudflare-worker/worker.js) ----
WORKER_URL=https://your-worker.your-name.workers.dev
WORKER_SECRET=same-long-random-text-as-in-the-worker

# ---- Optional ----
DB_NAME=filesharebot
PORT=8080
LOG_LEVEL=INFO
PAD_WIDTH=34

# ---- Local Database Backup / Recover (optional, defaults are fine)
# Host folders mounted into the container (docker-compose.yml). Use an absolute path to put them elsewhere, e.g. /restore
# RESTORE_HOST_DIR=./restore
# BK_TMP_HOST_DIR=./backup_tmp
# Seconds between two uploads while recovering (Telegram flood protection) and parallel chunks while backing up
# LR_PACE=3
# LB_PREFETCH=4
