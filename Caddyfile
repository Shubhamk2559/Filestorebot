# Automatic HTTPS (Let's Encrypt). DOMAIN comes from .env
{$DOMAIN} {
	# flush_interval -1 = send bytes immediately -> video streaming / downloads start fast and never buffer in RAM
	reverse_proxy bot:8080 {
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}
