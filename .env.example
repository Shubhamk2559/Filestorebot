# ---- Required ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# Needed for Stream mode / range autoposter (https://my.telegram.org -> API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ---- VPS (docker compose + Caddy) ----
# Your domain (A record must point to the VPS IP). Caddy gets the HTTPS certificate automatically.
# docker-compose.yml sets BASE_URL=https://$DOMAIN for you.
DOMAIN=bot.example.com

# Only when you do NOT use docker compose (own reverse proxy / Koyeb / Render): public https URL, no trailing slash
# BASE_URL=https://bot.example.com

# ---- Optional ----
# Permanent share links through a Cloudflare Worker
# WORKER_URL=https://your-worker.your-name.workers.dev
# WORKER_SECRET=same-long-random-text-as-in-the-worker
DB_NAME=filesharebot
MONGO_LIMIT_MB=512
LOG_LEVEL=INFO
