# ---- Required (the ONLY things configured here; everything else is set from the bot's admin panel) ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
# Needed for Stream mode (get them at https://my.telegram.org) + BASE_URL = your public https URL, no trailing slash
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BASE_URL=https://your-app-name.koyeb.app

# ---- Optional ----
DB_NAME=filesharebot
PORT=8080
LOG_LEVEL=INFO
