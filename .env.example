# ---- Required ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# Optional: only for the Autoposter "Range" mode + Duo Reel preview image (https://my.telegram.org -> API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ---- VPS (docker compose + Caddy) ----
# Your domain (A record must point to the VPS IP). Caddy gets the HTTPS certificate automatically.
# docker-compose.yml sets BASE_URL=https://$DOMAIN for you.
DOMAIN=bot.example.com

# Only when you do NOT use docker compose (own reverse proxy / Koyeb / Render): public https URL, no trailing slash
# BASE_URL=https://bot.example.com

# ---- Optional ----
# Permanent share links through a Cloudflare Worker
# WORKER_URL=https://your-worker.your-name.workers.dev
# WORKER_SECRET=same-long-random-text-as-in-the-worker
DB_NAME=filesharebot
MONGO_LIMIT_MB=512
LOG_LEVEL=INFO

# Invisible padding that makes message bubbles as wide as their buttons (0 = off, raise/lower to tune)
# PAD_WIDTH=34

# ---- Landing page: the ONE channel link shown under the main button ----
HOME_CHANNEL=https://t.me/+5E10CZrWvowxZTVh
HOME_CHANNEL_NAME=Our Channel

# ---- Local Database Backup / Recover (optional, defaults are fine)
# Host folders mounted into the container (docker-compose.yml). Use an absolute path to put them elsewhere, e.g. /restore
# RESTORE_HOST_DIR=./restore
# BK_TMP_HOST_DIR=./backup_tmp
# Seconds between two uploads while recovering (Telegram flood protection)
# LR_PACE=3
# --- Local backup speed (all optional) ---
# Files downloaded at the same time / parallel Telegram requests in total / MTProto clients (= connection sets)
# LB_FILES=5
# LB_TRANSFERS=16
# LB_CLIENTS=2
# MiB fetched by one request call (4 = good default) / max RAM for downloaded-but-not-yet-written data / zip write block
# LB_STRIPE=4
# LB_BUFFER_MB=128
# LB_WRITE_MB=8
# LB_PREFETCH=4
