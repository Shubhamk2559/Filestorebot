# ---- Required (the ONLY things configured here; everything else is set from the bot's admin panel) ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
# API_ID / API_HASH are kept for compatibility (needed only if you ever switch to Pyrogram). Optional here.
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ---- Optional ----
DB_NAME=filesharebot
PORT=8080
LOG_LEVEL=INFO
